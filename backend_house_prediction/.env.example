# Copy to `.env` and edit. Every value here is optional — the app runs without it.
# Real environment variables take precedence over this file.

# ---- Paths ----
# DATA_PATH=data/pp-monthly-update-new-version.csv
# MODEL_PATH=models/house_price_model.pkl

# ---- Server ----
# 0.0.0.0 = listen on all interfaces (required for Docker/Render).
# Use 127.0.0.1 locally if you want it reachable only on this machine.
API_HOST=0.0.0.0
API_PORT=8000
# Auto-reload on code changes. Development only.
RELOAD=true

# ---- CORS ----
# Comma-separated origins allowed to call the API from a browser.
# Defaults to the Vite dev + preview servers. Set your real domain in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ---- Training ----
RANDOM_STATE=42
TEST_SIZE=0.2
CV_FOLDS=5
