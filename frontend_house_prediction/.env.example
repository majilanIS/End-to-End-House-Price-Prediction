# Copy to `.env`. Only variables prefixed with VITE_ are exposed to the browser —
# never put secrets in this file, it is bundled into the built JavaScript.

# Base URL of the FastAPI backend.
# Empty  -> use relative paths + the Vite dev proxy (recommended for development).
# Set    -> call the backend directly, e.g. https://api.your-domain.com
VITE_API_BASE_URL=

# Where the dev server proxies to. Only used when VITE_API_BASE_URL is empty.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
