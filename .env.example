# Copy to `.env` for `docker compose` (root level). Every value is optional.
# Vite variables are baked into the frontend image at build time, so changing
# VITE_API_BASE_URL requires `docker compose build --no-cache frontend`.

# Public port the app is served on. http://localhost:<PORT> by default.
PORT=8080

# Keep EMPTY: nginx inside the app container proxies API calls to the backend,
# so the whole site stays on one origin. Set it only if the API runs elsewhere,
# e.g. VITE_API_BASE_URL=https://api.your-domain.com — then the backend's
# ALLOWED_ORIGINS must list this app's origin.
VITE_API_BASE_URL=

# CORS origins the backend allows. Not used when proxied through nginx.
ALLOWED_ORIGINS=http://localhost:8080