# Copy to `.env` for `docker compose` (root level). Every value is optional.
#
# NOTE: `docker-compose.yml` runs the BACKEND only. The React frontend is a
# static bundle deployed separately (GitHub Pages / any static host); its API
# URL is baked at build time via VITE_API_BASE_URL in .github/workflows/frontend-pages.yml.

# Public port the backend API is served on. http://localhost:<PORT> by default.
PORT=8000

# Not used by docker compose (no frontend container). Kept here as a pointer:
# the deployed frontend calls the backend directly, so VITE_API_BASE_URL at
# build time points at the public API URL, and that URL's ALLOWED_ORIGINS must
# list the frontend's origin.
VITE_API_BASE_URL=

# CORS origins the backend allows. Must include every frontend origin that
# calls the API from a browser (no trailing slashes; the Origin header has none).
ALLOWED_ORIGINS=http://localhost:5173,https://majilanis.github.io,https://end-to-end-house-price-prediction-ten.vercel.app